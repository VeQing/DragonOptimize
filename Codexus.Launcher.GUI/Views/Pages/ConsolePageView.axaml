<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codexus.Launcher.GUI.ViewModels.Pages"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:srv="using:Codexus.Launcher.GUI.Services"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="560"
             x:Class="Codexus.Launcher.GUI.Views.Pages.ConsolePageView"
             x:DataType="vm:ConsolePageViewModel">

    <Grid RowDefinitions="Auto, Auto, *" Margin="32,24">
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="控制台" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="OpenTransport 连接状态、事件日志、Serilog 输出。" Opacity="0.6" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,12" VerticalAlignment="Center">
            <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Width="8" Height="8" CornerRadius="4"
                    Background="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    VerticalAlignment="Center" />
            <Button Content="清空" Command="{Binding ClearCommand}" />
            <Button Content="停止连接" Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}" />
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1" CornerRadius="4"
                Background="{DynamicResource SystemControlBackgroundAltMediumBrush}">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding LogItems}" Padding="8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="srv:UiLogSink+LogEntry">
                            <Grid ColumnDefinitions="Auto, Auto, *">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Time, StringFormat='HH:mm:ss'}"
                                           Opacity="0.5" FontFamily="Cascadia Mono,Consolas,monospace"
                                           Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Level}"
                                           FontWeight="SemiBold"
                                           FontFamily="Cascadia Mono,Consolas,monospace"
                                           Margin="0,0,8,0" Width="50" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Message}"
                                           TextWrapping="Wrap"
                                           FontFamily="Cascadia Mono,Consolas,monospace" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
